# ==========================================
# StoneWay Environment Configuration Template
# All secret values must remain server-side.
# Never commit actual secret credentials.
# ==========================================

# 1. Authoritative Neon PostgreSQL Database
DATABASE_URL="postgres://user:password@ep-sample-12345.us-east-2.aws.neon.tech/stoneway?sslmode=require"

# 2. Better Auth Configuration
BETTER_AUTH_SECRET="your-32-byte-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub OAuth Application (optional for development, required for production sign-in)
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# 3. StoneWay Envelope & Secret Encryption Key
# 32-byte AES-256-GCM key encoded in Base64
ENCRYPTION_KEY_BASE64="your_base64_encoded_32_byte_key"

# 4. Storage Provider 1: Vercel Blob (Primary active context uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# 5. Storage Provider 2: Upstash Blob (S3-compatible, derived & preview assets)
UPSTASH_BLOB_TOKEN="upstash_blob_sample_token"

# 6. Storage Provider 3: Filebase (S3-compatible, archival & large payloads >15MB)
FILEBASE_KEY="your_filebase_access_key"
FILEBASE_SECRET="your_filebase_secret_key"
FILEBASE_ENDPOINT="https://s3.filebase.io"
FILEBASE_BUCKET="stoneway-context"

# 7. Upstash Redis (Short-lived caching, rate limiting, and idempotency)
# Fails open to PostgreSQL database if unconfigured or offline
KV_REST_API_URL="https://sample-redis.upstash.io"
KV_REST_API_TOKEN="your_upstash_redis_rest_token"
# Optional fallback aliases
# UPSTASH_REDIS_REST_URL="https://sample-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"
# REDIS_URL="rediss://default:token@sample-redis.upstash.io:6379"

# 8. MCP Authentication (For testing MCP tools locally)
STONEWAY_TOKEN="sw_your_personal_api_key"
